# borderlands-1 — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
# Address the secure server advertises to clients.
NEXTENDO_HOST=127.0.0.1
# Set to 1 if this server sits behind a proxy that speaks the PROXY protocol (sni-router).
NEXTENDO_PROXY_PROTOCOL=0
# Auth / secure WSS ports.
AUTH_PORT=443
SECURE_PORT=60012
# TLS cert/key files (server-side; these are ignored by git).
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Nextendo account integration ---
NEXTENDO_ACCOUNT_URL=https://nextendo.network
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Secrets (set these to strong random values in production) ---
NEXTENDO_INTERNAL_KEY=change-me
NEXTENDO_SECRET=change-me
NEXTENDO_SECRET_FILE=
# Kerberos password shared between the auth and secure endpoints. REQUIRED.
NEXTENDO_SECURE_PASSWORD=change-me
NEXTENDO_SNI_HOST=

# --- Monitoring ---
DASH_PORT=8094
DASH_TOKEN=change-me

# --- Borderlands ---
# 8-hex NEX access key from the game — REQUIRED, the server refuses to start without it.
BL1_ACCESS_KEY=
# NEX version the game was built with (4.x). Confirm from captures.
BL1_NEX_VERSION=40000
